-- @__p_0='10'
SELECT b0."Id", b0."Name", (
    SELECT count(*)::int
    FROM "Brands" AS b1) AS "TotalCount"
FROM (
    SELECT b."Id", b."Name"
    FROM "Brands" AS b
    ORDER BY b."Name" DESC, b."Id" DESC
    LIMIT @__p_0
) AS b0
ORDER BY b0."Name", b0."Id"

-- @__value_0='Synerflux'
-- @__value_1='19'
-- @__p_2='2'
SELECT b0."Id", b0."GroupId", b0."Name"
FROM (
    SELECT b."Id", b."GroupId", b."Name"
    FROM "Brands" AS b
    WHERE b."Name" < @__value_0 OR (b."Name" = @__value_0 AND b."Id" < @__value_1)
    ORDER BY b."Name" DESC, b."Id" DESC
    LIMIT @__p_2
) AS b0
ORDER BY b0."Name", b0."Id"

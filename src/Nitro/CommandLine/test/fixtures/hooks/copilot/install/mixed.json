{
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "/usr/local/bin/herdr-agent-state.sh",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "command": "/opt/old/nitro agent hook copilot session-start",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "/home/agent/.dotnet/tools/nitro agent hook copilot user-prompt-submit",
        "timeoutSec": 10
      }
    ]
  }
}

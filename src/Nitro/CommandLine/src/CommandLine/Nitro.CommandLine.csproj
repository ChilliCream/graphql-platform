<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <PublishAot>false</PublishAot>
    <UseAppHost>false</UseAppHost>
    <ToolCommandName>nitro</ToolCommandName>
    <RootNamespace>ChilliCream.Nitro.CommandLine</RootNamespace>
    <AssemblyName>nitro</AssemblyName>
    <PackageId>ChilliCream.Nitro.CommandLine</PackageId>
    <!-- IL3053/IL2104: the raw Dapper package reference (kept alongside Dapper.AOT for its interceptors) is not
         itself marked AOT/trim compatible, so ILC reports its reflection-based fallback surface under these two
         codes. Dapper.AOT's interceptors replace the actual call sites, and these are the only ILC warnings this
         project produces, so they are suppressed here rather than in a shared build file. -->
    <NoWarn>$(NoWarn);CS0618;IL3053;IL2104</NoWarn>
    <!-- Dapper.AOT rewrites Dapper calls via C# interceptors; without this its generator cannot intercept and calls fall back to reflection-based Dapper. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GraphQLPersistedOperationOutput>persisted</GraphQLPersistedOperationOutput>
    <GraphQLPersistedOperationFormat>relay</GraphQLPersistedOperationFormat>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="ChilliCream.Nitro.CommandLine" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Spectre.Console" />
    <Using Include="System.Linq" />
    <Using Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\HotChocolate\Adapters\src\Adapters.Mcp.Core\HotChocolate.Adapters.Mcp.Core.csproj" />
    <ProjectReference Include="..\..\..\..\HotChocolate\Adapters\src\Adapters.OpenApi.Core\HotChocolate.Adapters.OpenApi.Core.csproj" />
    <ProjectReference Include="..\..\..\..\HotChocolate\Fusion\src\Fusion.AspNetCore\HotChocolate.Fusion.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\HotChocolate\Fusion\src\Fusion.Composition\HotChocolate.Fusion.Composition.csproj" />
    <ProjectReference Include="..\..\..\..\HotChocolate\Fusion\src\Fusion.Packaging\HotChocolate.Fusion.Packaging.csproj" />
    <ProjectReference Include="..\..\..\..\HotChocolate\Fusion\src\Fusion.SourceSchema.Packaging\HotChocolate.Fusion.SourceSchema.Packaging.csproj" />
    <ProjectReference Include="..\..\..\..\StrawberryShake\Client\src\Core\StrawberryShake.Core.csproj" />
    <ProjectReference Include="..\..\..\..\StrawberryShake\Client\src\Transport.Http\StrawberryShake.Transport.Http.csproj" />
    <ProjectReference Include="..\..\..\Common\src\ChilliCream.Nitro.Adapters.Mcp.Packaging\ChilliCream.Nitro.Adapters.Mcp.Packaging.csproj" />
    <ProjectReference Include="..\..\..\Common\src\ChilliCream.Nitro.Adapters.OpenApi.Packaging\ChilliCream.Nitro.Adapters.OpenApi.Packaging.csproj" />
    <ProjectReference Include="..\..\..\Common\src\ChilliCream.Nitro.Adapters.OpenApi\ChilliCream.Nitro.Adapters.OpenApi.csproj" />
    <ProjectReference Include="..\..\..\Common\src\ChilliCream.Nitro.Client\ChilliCream.Nitro.Client.csproj" />
    <ProjectReference Include="..\CommandLine.FusionCompatibility\Nitro.CommandLine.FusionCompatibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" VersionOverride="6.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.AspNetCore.HeaderPropagation" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Json" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Linq.Async" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="System.Linq.Async" />
  </ItemGroup>

</Project>

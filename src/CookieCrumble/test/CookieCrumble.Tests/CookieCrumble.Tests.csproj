<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>CookieCrumble.Tests</AssemblyName>
    <RootNamespace>CookieCrumble</RootNamespace>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" VersionOverride="17.14.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" VersionOverride="1.9.1" />
    <PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CookieCrumble.Analyzers\CookieCrumble.Analyzers.csproj" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\src\CookieCrumble.Xunit3\CookieCrumble.Xunit3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

  """
  The optional label that was added or removed from the issue.
  """
  label: GitHubLabel
  """
  The issue itself.
  """
  issue: GitHubIssue
  """
  A shallow version of the issue, if the issue was deleted.
  """
  deletedIssue: GitHubIssuesEventSubscriptionDeletedIssue

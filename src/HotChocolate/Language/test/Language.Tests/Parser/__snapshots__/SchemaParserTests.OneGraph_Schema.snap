  DRIBBBLE
  DROPBOX
  EGGHEADIO
  EVENTIL
  FACEBOOK
  GITHUB
  GMAIL
  GOOGLE_ANALYTICS
  GOOGLE_CALENDAR
  GOOGLE_COMPUTE
  GOOGLE_DOCS
  GOOGLE_TRANSLATE
  HUBSPOT
  INTERCOM
  MAILCHIMP
  MEETUP
  QUICKBOOKS
  SALESFORCE
  SLACK
  SPOTIFY
  STRIPE
  TRELLO
  TWILIO
  TWITTER
  TWITCH_TV
  YOUTUBE
  ZENDESK
}


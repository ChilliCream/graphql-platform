"""
The action that was performed that triggered an issues event.
"""
enum GitHubIssuesEventSubscriptionActionEnum {
  OPENED
  EDITED
  DELETED
  PINNED
  UNPINNED
  CLOSED
  REOPENED
  ASSIGNED
  UNASSIGNED
  LABELED
  UNLABELED
  LOCKED
  UNLOCKED
  TRANSFERRED
  MILESTONED
  DEMILESTONED
}


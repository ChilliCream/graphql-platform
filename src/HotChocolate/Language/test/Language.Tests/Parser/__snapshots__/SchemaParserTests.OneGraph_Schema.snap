  masterRecordId: String
  """
  Master Record ID
  """
  masterRecord: SalesforceContact
  """
  Account ID
  """
  accountId: String
  """
  Account ID
  """
  account: SalesforceAccount
  """
  Last Name
  """
  lastName: String!
  """
  First Name
  """
  firstName: String
  """
  Salutation
  """
  salutation: String
  """
  Full Name
  """
  name: String!
  """
  Other Street
  """
  otherStreet: String
  """
  Other City
  """
  otherCity: String
  """
  Other State/Province
  """
  otherState: String
  """
  Other Zip/Postal Code
  """
  otherPostalCode: String
  """
  Other Country
  """
  otherCountry: String
  """
  Other Latitude
  """
  otherLatitude: Float

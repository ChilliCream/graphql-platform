{
  "QueryTypeName": "Q",
  "MutationTypeName": null,
  "SubscriptionTypeName": null,
  "StrictValidation": false,
  "UseXmlDocumentation": true,
  "ResolveXmlDocumentationFileName": null,
  "SortFieldsByName": true,
  "SortEnumValuesByName": false,
  "RemoveUnreachableTypes": false,
  "RemoveUnusedTypeSystemDirectives": true,
  "DefaultBindingBehavior": "Implicit",
  "DefaultFieldBindingFlags": "Instance",
  "FieldMiddleware": "UserDefinedFields",
  "EnableDirectiveIntrospection": false,
  "EnableObjectDeprecation": true,
  "DefaultDirectiveVisibility": "Public",
  "DisableInternalDirectives": false,
  "DefaultResolverStrategy": "Parallel",
  "ValidatePipelineOrder": true,
  "StrictRuntimeTypeValidation": false,
  "DefaultIsOfTypeCheck": null,
  "EnableFlagEnums": true,
  "EnableDefer": false,
  "EnableStream": false,
  "StripLeadingIFromInterface": false,
  "EnableTag": true,
  "EnableOptInFeatures": false,
  "EnableSemanticIntrospection": true,
  "DefaultQueryDependencyInjectionScope": "Resolver",
  "DefaultMutationDependencyInjectionScope": "Request",
  "PublishRootFieldPagesToPromiseCache": true,
  "LazyInitialization": false,
  "PreparedOperationCacheSize": 256,
  "OperationDocumentCacheSize": 256,
  "ApplyShareableToPageInfo": false,
  "ApplyShareableToConnections": false,
  "ApplyShareableToNodeFields": false,
  "ApplySerializeAsToScalars": false,
  "InferKeysFromLookups": false

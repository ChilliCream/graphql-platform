  "The item at the end of the edge."
  node: Publisher!
}

type renamed_DescriptorAttributeProbe {
  name: String!
}

type Shape {
  key: String!
  name: String!
}

"A connection to a list of items."
type SomeBooksConnection {
  "Information to aid in pagination."
  pageInfo: PageInfo!
  "A list of edges."
  edges: [SomeBooksEdge!]
  "A flattened list of the nodes."

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>HotChocolate.Data.ElasticSearch</PackageId>
    <AssemblyName>HotChocolate.Data.ElasticSearch</AssemblyName>
    <RootNamespace>HotChocolate.Data.ElasticSearch</RootNamespace>
    <Description>Contains extensions for seamless integration of Elasticsearch ES|QL into the HotChocolate.Data package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\src\Types.OffsetPagination\HotChocolate.Types.OffsetPagination.csproj" />
    <ProjectReference Include="..\..\..\Data\src\Data\HotChocolate.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ElasticSearchResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ElasticSearchResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ElasticSearchResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ElasticSearchResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Elastic.Clients.Esql" />
  </ItemGroup>

</Project>

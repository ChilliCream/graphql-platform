    id: ID! @fusion__inputField(schema: C) @fusion__inputField(schema: D)
  ): Order @fusion__field(schema: C) @fusion__field(schema: D)
  paymentById(id: ID! @fusion__inputField(schema: D)): Payment
    @fusion__field(schema: D)
  productById(id: ID! @fusion__inputField(schema: E)): Product
    @fusion__field(schema: E)
  products(
    after: String @fusion__inputField(schema: E)
    before: String @fusion__inputField(schema: E)
    first: Int @fusion__inputField(schema: E)
    last: Int @fusion__inputField(schema: E)
  ): ProductsConnection @fusion__field(schema: E)
  reviewById(id: ID! @fusion__inputField(schema: F)): Review
    @fusion__field(schema: F)
  userById(id: ID! @fusion__inputField(schema: A)): User
    @fusion__field(schema: A)
  userByUsername(username: String! @fusion__inputField(schema: A)): User
    @fusion__field(schema: A)
  users(
    after: String @fusion__inputField(schema: A)
    before: String @fusion__inputField(schema: A)
    first: Int @fusion__inputField(schema: A)
    last: Int @fusion__inputField(schema: A)
  ): UsersConnection @fusion__field(schema: A)
}


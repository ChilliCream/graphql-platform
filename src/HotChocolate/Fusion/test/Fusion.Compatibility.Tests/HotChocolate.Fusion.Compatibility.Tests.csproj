<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Test.props', '$(MSBuildThisFileDirectory)'))" />

  <!--
    This project is a deliberately non-friend Fusion consumer: it must never appear in any
    Fusion source project's InternalsVisibleTo list, and it must never reference the friend
    Fusion.*.Tests / Fusion.Tests.Shared projects that do have internals access. That is what
    lets it prove real, externally observable compatibility instead of hiding behind internals.
  -->

  <PropertyGroup>
    <AssemblyName>HotChocolate.Fusion.Compatibility.Tests</AssemblyName>
    <RootNamespace>HotChocolate.Fusion.Compatibility</RootNamespace>
    <!-- The committed baseline artifact under Baseline\artifacts is a net10.0 assembly, so only net10.0 and net11.0 can load it. -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Baseline/BaselineConsumer is its own isolated project (see its Directory.Build.props) and
      must never be compiled as part of this project; only its committed, prebuilt output under
      Baseline/artifacts is consumed, via the None/CopyToOutputDirectory item below.
    -->
    <Compile Remove="Baseline\**\*.cs" />
    <None Remove="Baseline\**\*.cs" />
    <None Remove="Baseline\**\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fusion.AspNetCore\HotChocolate.Fusion.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Caching\HotChocolate.Fusion.Caching.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Diagnostics\HotChocolate.Fusion.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Connectors.InMemory\HotChocolate.Fusion.Connectors.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Execution\HotChocolate.Fusion.Execution.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Packaging\HotChocolate.Fusion.Packaging.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Subscriptions.NATS\HotChocolate.Fusion.Subscriptions.NATS.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Subscriptions.Kafka\HotChocolate.Fusion.Subscriptions.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Subscriptions.Redis\HotChocolate.Fusion.Subscriptions.Redis.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Subscriptions.AmazonSqs\HotChocolate.Fusion.Subscriptions.AmazonSqs.csproj" />
    <ProjectReference Include="..\..\src\Fusion.Subscriptions.AzureEventHubs\HotChocolate.Fusion.Subscriptions.AzureEventHubs.csproj" />
    <ProjectReference Include="..\..\..\Adapters\src\Fusion.Adapters.Mcp\HotChocolate.Fusion.Adapters.Mcp.csproj" />
    <ProjectReference Include="..\..\..\Adapters\src\Fusion.Adapters.OpenApi\HotChocolate.Fusion.Adapters.OpenApi.csproj" />
    <ProjectReference Include="..\..\..\AspNetCore\src\AspNetCore\HotChocolate.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Basic.Reference.Assemblies.Net110" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Baseline\artifacts\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Baseline\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>

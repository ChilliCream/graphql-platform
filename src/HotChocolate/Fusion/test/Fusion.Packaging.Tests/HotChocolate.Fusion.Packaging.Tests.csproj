<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Test.props', '$(MSBuildThisFileDirectory)'))" />

  <PropertyGroup>
    <AssemblyName>HotChocolate.Fusion.Packaging.Tests</AssemblyName>
    <RootNamespace>HotChocolate.Fusion.Packaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.IO.Pipelines" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fusion.Packaging\HotChocolate.Fusion.Packaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="$(MSBuildProjectDirectory)\__resources__\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    tools\LegacyPackagingHarness is a standalone console project (its own pinned
    package reference to the released 16.6.4 HotChocolate.Fusion.Packaging), built
    and invoked out-of-process by ArchiveCompatibilityTests. None of it, including its
    own bin/obj output, may become part of this project's item set: picking up its
    compiled HotChocolate.Fusion.Packaging.dll (the old, pinned one) here would risk
    colliding with the renamed assembly this project references above.
  -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
  </ItemGroup>

</Project>

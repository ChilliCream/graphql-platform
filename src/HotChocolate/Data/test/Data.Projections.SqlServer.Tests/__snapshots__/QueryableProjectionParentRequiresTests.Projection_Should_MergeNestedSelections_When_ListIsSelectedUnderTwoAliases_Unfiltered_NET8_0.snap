SQL:
---------------
SELECT "d"."Id", "t"."Text", "t"."Name", "t"."Id", "t"."Rating", "t"."Id0"
FROM "Data" AS "d"
LEFT JOIN (
    SELECT "r"."Text", "a"."Name", "a"."Id", "r"."Rating", "r"."Id" AS "Id0", "r"."BookId"
    FROM "Review" AS "r"
    INNER JOIN "Author" AS "a" ON "r"."ReviewerId" = "a"."Id"
) AS "t" ON "d"."Id" = "t"."BookId"
ORDER BY "d"."Id", "t"."Id0"

<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Test.props', '$(MSBuildThisFileDirectory)'))" />
  <!-- The assembly name matches Mocha.Transport.RabbitMQ.Tests, because conventions derive names from it. -->
  <PropertyGroup>
    <AssemblyName>Mocha.Transport.RabbitMQ.Tests</AssemblyName>
    <RootNamespace>Mocha.Transport.RabbitMQ.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);RABBITMQ_3</DefineConstants>
  </PropertyGroup>

  <!-- Runs the tests of Mocha.Transport.RabbitMQ.Tests against RabbitMQ 3. -->
  <ItemGroup>
    <Compile
      Include="..\Mocha.Transport.RabbitMQ.Tests\**\*.cs"
      Exclude="..\Mocha.Transport.RabbitMQ.Tests\bin\**;..\Mocha.Transport.RabbitMQ.Tests\obj\**"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Mocha.TestHelpers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mocha\Mocha.csproj" />
    <ProjectReference Include="..\..\src\Mocha.Inbox\Mocha.Inbox.csproj" />
    <ProjectReference Include="..\..\src\Mocha.Transport.InMemory\Mocha.Transport.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Mocha.Transport.RabbitMQ\Mocha.Transport.RabbitMQ.csproj" />
    <ProjectReference Include="..\Mocha.TestHelpers\Mocha.TestHelpers.csproj" />
    <ProjectReference Include="..\..\..\CookieCrumble\src\CookieCrumble\CookieCrumble.csproj" />
    <ProjectReference Include="..\..\..\CookieCrumble\src\CookieCrumble.Xunit3\CookieCrumble.Xunit3.csproj" />
    <ProjectReference
      Include="..\..\..\CookieCrumble\src\CookieCrumble.Analyzers\CookieCrumble.Analyzers.csproj"
      OutputItemType="Analyzer"
    />
    <ProjectReference
      Include="..\..\..\CookieCrumble\src\CookieCrumble.Resources.RabbitMQ\CookieCrumble.Resources.RabbitMQ.csproj"
    />
  </ItemGroup>
</Project>

{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["--yes", "@playwright/mcp@0.0.79"]
    },
    "nuget": {
      "command": "dotnet",
      "args": [
        "dnx",
        "NuGet.Mcp.Server@1.4.16",
        "--source",
        "https://api.nuget.org/v3/index.json",
        "--yes"
      ]
    },
    "microsoft.docs.mcp": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}

# Use the base image specified in the devcontainer.json
FROM mcr.microsoft.com/devcontainers/base:bookworm

# Install dependencies
RUN apt-get update && apt-get install -y \
    wget \
    apt-transport-https \
    curl \
    gnupg2 \
    lsb-release \
    software-properties-common \
    openssh-server \
    bubblewrap

# Configure SSH server
RUN mkdir /var/run/sshd \
    && echo 'root:Docker!' | chpasswd \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's@session    required     pam_loginuid.so@session    optional     pam_loginuid.so@g' /etc/pam.d/sshd \
    && echo "export VISIBLE=now" >> /etc/profile

# Expose SSH port
EXPOSE 22

# Start SSH service
CMD ["/usr/sbin/sshd", "-D"]

# Install .NET SDKs (8, 9, 10, and 11)
RUN wget https://dot.net/v1/dotnet-install.sh -O dotnet-install.sh \
    && chmod +x dotnet-install.sh \
    && ./dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet \
    && ./dotnet-install.sh --channel 9.0 --install-dir /usr/share/dotnet \
    && ./dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet \
    && ./dotnet-install.sh --channel 11.0 --install-dir /usr/share/dotnet \
    && ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet

# Install Node.js 24 and the npm version required by website/package.json.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && npm install --global npm@11.18.0

# Install GitHub Copilot CLI and Codex CLI
RUN npm install -g @openai/codex @github/copilot

# Install Playwright's OS dependencies for Chromium (version-independent apt packages).
# The browser binary itself is downloaded in postCreateCommand so it matches the
# Playwright version resolved from package-lock.json. DejaVu is the fallback font the visual
# regression baselines are rendered with.
RUN apt-get update && npx -y playwright install-deps chromium \
    && apt-get install -y fonts-dejavu-core

# Install Claude Code (as vscode user so it installs to their home directory)
RUN su - vscode -c "curl -fsSL https://claude.ai/install.sh | bash"

# Pre-create the agent CLI config directories and the shell history directory so
# the persistent volumes mounted here inherit vscode ownership instead of
# defaulting to root
RUN mkdir -p /home/vscode/.claude /home/vscode/.codex /home/vscode/.copilot /home/vscode/.commandhistory \
    && chown -R vscode:vscode /home/vscode/.claude /home/vscode/.codex /home/vscode/.copilot /home/vscode/.commandhistory

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh

# Install Azure CLI
RUN curl -sL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor | tee /etc/apt/trusted.gpg.d/microsoft.asc.gpg > /dev/null \
    && AZ_REPO=$(lsb_release -cs) \
    && echo "deb [arch=$(dpkg --print-architecture)] https://packages.microsoft.com/repos/azure-cli/ $AZ_REPO main" | tee /etc/apt/sources.list.d/azure-cli.list \
    && apt-get update \
    && apt-get install -y azure-cli

# Install zsh plugins for better shell experience
RUN git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions /home/vscode/.oh-my-zsh/custom/plugins/zsh-autosuggestions \
    && git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting /home/vscode/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting \
    && chown -R vscode:vscode /home/vscode/.oh-my-zsh/custom/plugins/zsh-autosuggestions \
    && chown -R vscode:vscode /home/vscode/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting

# Configure Oh My Zsh: agnoster theme, useful plugins, claude-d alias
RUN sed -i 's/ZSH_THEME=".*"/ZSH_THEME="agnoster"/' /home/vscode/.zshrc \
    && sed -i 's/plugins=(.*)/plugins=(git gh dotnet node npm docker zsh-autosuggestions zsh-syntax-highlighting)/' /home/vscode/.zshrc \
    && echo 'export PATH="$HOME/.local/bin:$PATH"' >> /home/vscode/.zshrc \
    && echo 'alias claude-d="claude --dangerously-skip-permissions"' >> /home/vscode/.zshrc \
    && echo 'alias codex-a="codex --full-auto"' >> /home/vscode/.zshrc \
    && echo 'alias codex-d="codex --dangerously-bypass-approvals-and-sandbox"' >> /home/vscode/.zshrc \
    && echo 'DEFAULT_USER=$USER' >> /home/vscode/.zshrc

# Set zsh as default shell for vscode user
RUN chsh -s /bin/zsh vscode

# Configure GitHub SSH to use port 443 (avoids firewall blocks on port 22)
RUN mkdir -p /home/vscode/.ssh \
    && printf "Host github.com\n    Hostname ssh.github.com\n    Port 443\n    User git\n" > /home/vscode/.ssh/config \
    && chown -R vscode:vscode /home/vscode/.ssh \
    && chmod 700 /home/vscode/.ssh \
    && chmod 600 /home/vscode/.ssh/config

# Install the .NET diagnostics tools and the dotTrace command-line profiler as
# global tools for the vscode user (see docs/profiling.md). Versions are pinned.
RUN su - vscode -c "dotnet tool install --global dotnet-trace --version 10.0.750501 \
    && dotnet tool install --global dotnet-counters --version 10.0.750501 \
    && dotnet tool install --global dotnet-gcdump --version 10.0.750501 \
    && dotnet tool install --global dotnet-dump --version 10.0.750501 \
    && dotnet tool install --global dotnet-symbol --version 10.0.750501 \
    && dotnet tool install --global JetBrains.dotTrace.GlobalTools --version 2026.2.3.1 \
    && dotnet nuget locals http-cache --clear"

# Install the dotMemory command-line profiler. JetBrains publishes it only as a
# per-architecture NuGet package that bundles its own runtime (a plain zip, not
# a dotnet tool), so unpack it under /opt and expose the launcher on PATH.
RUN case "$(dpkg --print-architecture)" in \
        arm64) DOTMEMORY_RID=linux-arm64 ;; \
        amd64) DOTMEMORY_RID=linux-x64 ;; \
        *) echo "dotMemory: unsupported architecture $(dpkg --print-architecture)" >&2 && exit 1 ;; \
    esac \
    && curl -fsSL "https://api.nuget.org/v3-flatcontainer/jetbrains.dotmemory.console.${DOTMEMORY_RID}/2026.2.3.1/jetbrains.dotmemory.console.${DOTMEMORY_RID}.2026.2.3.1.nupkg" -o /tmp/dotmemory.nupkg \
    && mkdir -p /opt/dotmemory \
    && unzip -q /tmp/dotmemory.nupkg 'tools/*' -d /opt/dotmemory \
    && rm /tmp/dotmemory.nupkg \
    && chmod +x /opt/dotmemory/tools/dotmemory /opt/dotmemory/tools/runtime-dotnet.sh \
    && find "/opt/dotmemory/tools/${DOTMEMORY_RID}" -type f \( ! -name '*.*' -o -name 'JetBrains.Profiler.PdbServer' \) -exec chmod +x {} + \
    && printf '#!/bin/sh\nexec /opt/dotmemory/tools/dotmemory "$@"\n' > /usr/local/bin/dotmemory \
    && chmod +x /usr/local/bin/dotmemory

# Put the global tools on PATH for every process in the container, including
# the non-interactive shells that agents and editor tasks use.
ENV PATH="/home/vscode/.dotnet/tools:${PATH}"

# Clean up
RUN rm dotnet-install.sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

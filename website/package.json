{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && yarn generate:llms && yarn validate:llms",
    "start": "next start -p 3001",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate-git-metadata": "node scripts/generate-git-metadata.mjs",
    "generate-agent-skills": "node scripts/generate-agent-skills.mjs",
    "generate:llms": "node scripts/generate-llms-files.mjs",
    "validate:llms": "node scripts/validate-llms-files.mjs",
    "validate:structured-data": "node scripts/validate-structured-data.mjs",
    "ci-local": "bash start-optimized.sh",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:test": "storybook build --quiet --output-dir storybook-static",
    "test:visual": "yarn build-storybook:test && playwright test",
    "test:visual:update": "yarn build-storybook:test && playwright test --update-snapshots"
  },
  "dependencies": {
    "@chillicream/mocha-visualizer": "file:../src/Mocha/src/mocha-visualizer",
    "@docsearch/css": "^4.7.0",
    "@docsearch/react": "^4.7.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.3",
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.11.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.3.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-storybook": "10.5.10",
    "http-server": "^14.1.1",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^9.0.1",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-mermaid": "^3.0.0",
    "storybook": "10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "packageManager": "yarn@4.18.0",
  "browserslist": [
    "chrome >= 110",
    "firefox >= 110",
    "safari >= 16",
    "edge >= 110",
    "not dead",
    "not op_mini all"
  ],
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "sharp": {
      "built": true
    },
    "unrs-resolver": {
      "built": true
    }
  }

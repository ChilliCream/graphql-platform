{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "npm run validate:benchmarks && next build && npm run generate:llms && npm run validate:llms && npm run generate:indexnow-manifest",
    "start": "next start -p 3002",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate-git-metadata": "node scripts/generate-git-metadata.mjs",
    "generate-agent-skills": "node scripts/generate-agent-skills.mjs",
    "generate:llms": "node scripts/generate-llms-files.mjs",
    "validate:llms": "node scripts/validate-llms-files.mjs",
    "generate:indexnow-manifest": "node scripts/generate-indexnow-manifest.mjs",
    "indexnow:fetch-previous": "node scripts/indexnow-submit.mjs fetch-previous",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "indexnow:submit-all": "node scripts/indexnow-submit.mjs submit-all",
    "validate:structured-data": "node scripts/validate-structured-data.mjs",
    "test:validator": "node --test scripts/seo-validator.test.mjs",
    "validate:benchmarks": "node scripts/validate-benchmark-report.mjs",
    "test:indexnow": "node --test scripts/indexnow.test.mjs",
    "test:benchmarks": "node --test tests/benchmarks/*.test.mjs",
    "ci-local": "bash start-optimized.sh",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:test": "storybook build --quiet --output-dir storybook-static",
    "test:theme": "playwright test --config playwright.theme.config.ts",
    "test:visual": "npm run build-storybook:test && node scripts/visual-tests-docker.mjs",
    "test:visual:update": "npm run build-storybook:test && node scripts/visual-tests-docker.mjs --update-snapshots"
  },
  "dependencies": {
    "@chillicream/mocha-visualizer": "file:../src/Mocha/src/mocha-visualizer",
    "@docsearch/css": "^5.2.0",
    "@docsearch/react": "^5.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.6",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "motion": "^13.5.1",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "styled-components": "^6.6.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-storybook": "10.6.7",
    "http-server": "^14.1.1",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^9.0.7",
    "playwright": "1.65.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-mermaid": "^3.0.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vite": "^8.3.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">=11.18.0"
    }
  },
  "browserslist": [
    "chrome >= 110",
    "firefox >= 110",
    "safari >= 16",
    "edge >= 110",
    "not dead",
    "not op_mini all"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "unrs-resolver@1.12.2": true
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage

# playwright visual tests (committed baselines live in tests/visual/__screenshots__)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# build-time image optimization output
/public/_optimized/

# build-time agent skills discovery output (fetched from chillicream/agent-skills)
/public/.well-known/agent-skills/

# generated git metadata (produced by the release workflow)
/git-metadata.generated.json

# storybook
/storybook-static/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

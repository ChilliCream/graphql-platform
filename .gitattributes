# Normalize to LF on commit; checkout follows local Git config
* text=auto

# Scripts with interpreter lines must have LF
*.sh        text eol=lf
*.bash      text eol=lf
*.mjs       text eol=lf

# Windows scripts
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Vendored patch file: preserve as-is, skip whitespace checks
src/HotChocolate/CostAnalysis/tools/oracle/oracle.patch -whitespace

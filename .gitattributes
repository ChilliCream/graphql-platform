# Normalize to LF on commit and checkout
* text=auto eol=lf

# Scripts with interpreter lines must have LF
*.sh        text eol=lf
*.bash      text eol=lf
*.mjs       text eol=lf

# Windows scripts
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary profile data
*.mibc      binary

# Code order file for Native AOT publishes: symbol names, one per line
*.order     text eol=lf

# Vendored patch file: preserve as-is, skip whitespace checks
src/HotChocolate/CostAnalysis/tools/oracle/oracle.patch -whitespace

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Fusion (preview channel) composing Apollo Federation subgraphs. This variant
       is .NET 10 only, so unlike the composite-schema Fusion gateway it declares its
       own TargetFramework here: the apollo-federation tree has no Directory.Build.props
       to inherit one from. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>eShop.Gateway</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Generated by install.sh when needed (gitignored): net11 retarget +
       runtime-async for BENCH_GATEWAY_DOTNET=11, and FUSION_16_7_OR_GREATER
       when the resolved HotChocolate version is 16.7 or greater. Absent for
       plain `dotnet build` on stable pins, which stays on net10.0 with the
       ModifyCostOptions call in Program.cs compiled out. Imported after the
       PropertyGroup above so bench.props wins on TargetFramework. -->
  <Import Project="bench.props" Condition="Exists('bench.props')" />

  <ItemGroup>
    <ProjectReference Include="../../../src/HotChocolate/AspNetCore/src/AspNetCore.Pipeline/HotChocolate.AspNetCore.Pipeline.csproj" />
    <ProjectReference Include="../../../src/HotChocolate/Fusion/src/Fusion.AspNetCore/HotChocolate.Fusion.AspNetCore.csproj" />
    <ProjectReference Include="../../../src/HotChocolate/Fusion/src/Fusion.Execution.Types/HotChocolate.Fusion.Execution.Types.csproj" />
    <ProjectReference Include="../../../src/HotChocolate/Fusion/src/Fusion.Execution/HotChocolate.Fusion.Execution.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.HeaderPropagation" Version="10.0.6" />
  </ItemGroup>

</Project>
